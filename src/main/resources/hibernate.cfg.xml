<hibernate-configuration>
    <session-factory>
        <property name="hibernate.dialect">net.ucanaccess.hibernate.dialect.UCanAccessDialect</property>
        <property name="hibernate.connection.driver_class">net.ucanaccess.jdbc.UcanaccessDriver</property>
        <property name="hibernate.globally_quoted_identifiers">true</property>
        <property name="hibernate.naming.physical-strategy">org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl</property>

        <property name="connection_pool_size">1</property>

        <property name="hbm2ddl.auto">update</property>
        <property name="show_sql">true</property>

        <mapping class="com.allinweb.ch.dto.VariableDTO"/>
        <mapping class="com.allinweb.ch.dto.ConfigurationDTO"/>
        <mapping class="com.allinweb.ch.dto.BaseDTO"/>
        <mapping class="com.allinweb.ch.dto.HomeBankingDTO"/>
        <mapping class="com.allinweb.ch.dto.BotJobDTO"/>
        <mapping class="com.allinweb.ch.dto.BlockDTO"/>
        <mapping class="com.allinweb.ch.dto.BlockLoopInstructionDTO"/>
        <mapping class="com.allinweb.ch.dto.ComplexInstructionDTO"/>
        <mapping class="com.allinweb.ch.dto.InstructionReferenceDTO"/>
        <mapping class="com.allinweb.ch.dto.ExcelReportDTO"/>

    </session-factory>
</hibernate-configuration>